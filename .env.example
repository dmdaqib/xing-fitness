# ==============================================================================
# XING FITNESS — PRODUCTION ENVIRONMENT CONFIGURATION (HOSTINGER)
# Sourced for deployment at xingfitness.in
# ==============================================================================

# Application Environment (production / development)
NODE_ENV=production

# Server Port (Hostinger assigns PORT dynamically, default: 3000)
PORT=3000

# Server Host (0.0.0.0 binds to all container/reverse-proxy interfaces)
HOST=0.0.0.0

# Mandatory Production Auth/Session Secret (Minimum 32 random characters)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_secure_random_32_character_string_minimum

# Persistent Database File Path (Optional)
# For Hostinger: Set to a persistent directory outside public_html to prevent git pull overwrites
# e.g., /home/u123456789/data/xing_db.json
DB_PATH=./server/data/db.json

# Official Production Website URL
APP_URL=https://xingfitness.in

# Transactional Email Configuration (Optional - leave blank if using in-app lead management)
# Hostinger Titan Mail / Custom SMTP:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=notifications@xingfitness.in
# SMTP_PASS=your_secure_password
# NOTIFICATION_RECIPIENT_EMAIL=xing.fitnessclub@gmail.com
